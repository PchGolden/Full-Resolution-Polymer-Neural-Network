#!/usr/bin/env bash
#SBATCH --job-name=BCDB_frpn_full_pt_withvol_5fold_100ep
#SBATCH --partition=gpuA800
#SBATCH --mem=60G
#SBATCH --gres=gpu:4
#SBATCH --time=2-00:00:00
#SBATCH --ntasks-per-node=8
#SBATCH --output=sbatch/sbatch_log/BCDB_frpn_full_pt_withvol_5fold_100ep_%A_%a.out
#SBATCH --error=sbatch/sbatch_log/BCDB_frpn_full_pt_withvol_5fold_100ep_%A_%a.err
#SBATCH --array=0-4

# Run from the repository root, or set FRPN_ROOT explicitly.
FRPN_ROOT="${FRPN_ROOT:-${SLURM_SUBMIT_DIR:-$PWD}}"

set -eo pipefail

cd "$SLURM_SUBMIT_DIR"
source ~/.bashrc
conda activate "${FRPN_ENV:-frpn}"
cd "${FRPN_ROOT}"
mkdir -p sbatch/sbatch_log

export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

PKL_PATH="${FRPN_ROOT}/data/processed/BCDB_chain_withvolume.pkl"
PRETRAIN_WT="${FRPN_ROOT}/../zenodo/checkpoints/pretrained/checkpoint_adaptive.pt"

fold=${SLURM_ARRAY_TASK_ID}
PORT=$(( 30100 + SLURM_ARRAY_TASK_ID ))

echo "[FRPN-FULL-PT] fold=${fold} pkl=${PKL_PATH} weight=${PRETRAIN_WT}"

ARGS=(
  --main_task chain
  --fold "${fold}"
  --dataset_name BCDB
  --pkl_path "${PKL_PATH}"
  --epochs 100
  --lr 1e-4
  --weight_decay 1e-2
  --task_type cls
  --batch_size 8
  --num_tasks 2
  --wo_triopm
  --amp
  --seed 42
  --max_chain_tokens 1536
  --weight_path "${PRETRAIN_WT}"
  --results_root ${FRPN_ROOT}/results_frpn_fullchain_pt_withvol_100ep
  --distributed
)

torchrun --standalone --nproc_per_node=4 --master_port="${PORT}" frpn/pipelines/bcdb/main.py "${ARGS[@]}"

