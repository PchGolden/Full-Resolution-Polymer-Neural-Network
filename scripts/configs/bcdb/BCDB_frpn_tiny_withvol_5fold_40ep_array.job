#!/usr/bin/env bash
#SBATCH --job-name=BCDB_frpn_tiny_withvol_40ep
#SBATCH --partition=gpuA800
#SBATCH --mem=50G
#SBATCH --gres=gpu:1
#SBATCH --time=1-00:00:00
#SBATCH --cpus-per-task=8
#SBATCH --output=sbatch/sbatch_log/BCDB_frpn_tiny_withvol_40ep/%A_%a.out
#SBATCH --error=sbatch/sbatch_log/BCDB_frpn_tiny_withvol_40ep/%A_%a.err
#SBATCH --array=0-4

FRPN_ROOT="${FRPN_ROOT:-${SLURM_SUBMIT_DIR:-$PWD}}"

set -eo pipefail

cd "$SLURM_SUBMIT_DIR"
mkdir -p sbatch/sbatch_log/BCDB_frpn_tiny_withvol_40ep

source "$HOME/anaconda3/etc/profile.d/conda.sh"
conda activate "${FRPN_ENV:-frpn}"

export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

ROOT="${FRPN_ROOT}"
PKL_PATH="${ROOT}/data/processed/BCDB_chain_withvolume.pkl"
SCRATCH_WT=""
RESULTS_ROOT="${ROOT}/results_bcdb_frpn_tiny_withvol_40ep"

fold="${SLURM_ARRAY_TASK_ID}"

echo "[BCDB-FRPN-TINY] fold=${fold} pkl=${PKL_PATH}"

ARGS=(
  --main_task chain
  --fold "${fold}"
  --dataset_name BCDB
  --pkl_path "${PKL_PATH}"
  --epochs 40
  --lr 1e-4
  --weight_decay 1e-2
  --task_type cls
  --batch_size 8
  --num_tasks 2
  --wo_triopm
  --amp
  --seed 42
  --max_chain_tokens 1536
  --weight_path "${SCRATCH_WT}"
  --results_root "${RESULTS_ROOT}"
  --encoder_layers 4
  --encoder_embed_dim 384
  --encoder_attention_heads 6
  --encoder_ffn_embed_dim 1536
  --pair_embed_dim 128
  --pair_hidden_dim 32
  --chain_encoder_layers 2
  --chain_attention_heads 6
  --chain_pair_dim 16
  --chain_pair_hidden_dim 16
  --chain_ffn_embed_dim 1536
)

python -u frpn/pipelines/bcdb/main.py "${ARGS[@]}"
