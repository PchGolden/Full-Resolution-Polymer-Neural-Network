#!/bin/bash
#SBATCH -J HOMO_PLOT_OOF
#SBATCH -p gpuA800
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH -t 02:00:00
#SBATCH -o reproduce/outputs/logs/slurm/HOMO_MDSTYLE/plots/%x_%j.out
#SBATCH -e reproduce/outputs/logs/slurm/HOMO_MDSTYLE/plots/%x_%j.err

# Run from the repository root, or set FRPN_ROOT explicitly.
FRPN_ROOT="${FRPN_ROOT:-${SLURM_SUBMIT_DIR:-$PWD}}"

set -eo pipefail
cd "${FRPN_ROOT}"

mkdir -p reproduce/outputs/logs/slurm/HOMO_MDSTYLE/plots

source "$HOME/anaconda3/etc/profile.d/conda.sh"
conda activate "${FRPN_ENV:-frpn}"

export MPLBACKEND=Agg
export PYTHONUNBUFFERED=1

RESULTS_ROOT="reproduce/outputs/training/results_homopolymer_mdstyle/HOMO_372"
PKL_DIR="datasets/processed/HOMO_372/homopolymer/main"
OUT_DIR="reproduce/outputs/analysis/homopolymer_oof_scatter_mdstyle"

python -u -m reproduce.evaluate.homopolymer_figures \
  --results_root "${RESULTS_ROOT}" \
  --pkl_dir "${PKL_DIR}" \
  --out_dir "${OUT_DIR}" \
  --batch_size 256 \
  --device cuda \
  --cache
