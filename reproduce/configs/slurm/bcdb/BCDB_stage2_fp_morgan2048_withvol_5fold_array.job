#!/usr/bin/env bash
#SBATCH --job-name=BCDB_s2fp_morgan2048_withvol_5fold
#SBATCH --partition=gpuA800
#SBATCH --mem=60G
#SBATCH --gres=gpu:4
#SBATCH --time=2-00:00:00
#SBATCH --ntasks-per-node=8
#SBATCH --output=reproduce/outputs/logs/slurm/BCDB_s2fp_morgan2048_withvol_5fold_%A_%a.out
#SBATCH --error=reproduce/outputs/logs/slurm/BCDB_s2fp_morgan2048_withvol_5fold_%A_%a.err
#SBATCH --array=0-4

# Run from the repository root, or set FRPN_ROOT explicitly.
FRPN_ROOT="${FRPN_ROOT:-${SLURM_SUBMIT_DIR:-$PWD}}"

set -eo pipefail

cd "${FRPN_ROOT}"
source ~/.bashrc
conda activate "${FRPN_ENV:-frpn}"
cd "${FRPN_ROOT}"
mkdir -p reproduce/outputs/logs/slurm

export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

PKL_PATH="${FRPN_ROOT}/datasets/processed/BCDB_chain_withvolume.pkl"
SCRATCH_WT=""  # Empty path selects scratch initialization.

fold=${SLURM_ARRAY_TASK_ID}
PORT=$(( 29800 + SLURM_ARRAY_TASK_ID ))

echo "[S2-FP] fold=${fold} pkl=${PKL_PATH}"

ARGS=(
  --main_task stage2_only
  --stage2_only_repr fp_morgan2048
  --fp_csv ${FRPN_ROOT}/datasets/raw/bcdb/bcdb.csv
  --fold "${fold}"
  --dataset_name BCDB
  --pkl_path "${PKL_PATH}"
  --epochs 100
  --lr 1e-4
  --weight_decay 1e-2
  --task_type cls
  --batch_size 8
  --num_tasks 2
  --wo_triopm
  --amp
  --seed 42
  --max_chain_tokens 1536
  --weight_path "${SCRATCH_WT}"
  --results_root ${FRPN_ROOT}/reproduce/outputs/training/results_stage2_fp_morgan2048_withvol
  --distributed
)

torchrun --standalone --nproc_per_node=4 --master_port="${PORT}" -m frpn.bcdb.train "${ARGS[@]}"

